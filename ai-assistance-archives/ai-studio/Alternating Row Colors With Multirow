        "text": "}{0pt}\n\\setlength{\\belowrulesep}{0pt}\n\\renewcommand{\\arraystretch}{1."
      }, {
        "text": "3}\n\n\\rowcolors{2}{gray!10}{white}\n\\begin{tabular}{llc"
      }, {
        "text": "}\n\\toprule\n\\rowcolor{gray!30} \\textbf{Metabolite} \u0026 \\textbf{Dependency}"
      }, {
        "text": " \u0026 \\textbf{Effect} \\\\\n\\midrule\n\\cellcolor{white} GLC (Intracellular Glucose) \u0026 GLC \u0026"
      }, {
        "text": " $\\pm$ (self-limiting) \\\\\n\\midrule\n\\cellcolor{white} \u0026 GLC \u0026 + \\\\\n"
      }, {
        "text": "\\cellcolor{white} \u0026 G6P \u0026 $-$ (self-limiting) \\\\\n\\cellcolor{white} \\"
      }, {
        "text": "multirow{-3}{*}{G6P (Glucose-6-Phosphate)} \u0026 F6P \u0026 + (via GPI"
      }, {
        "text": " equilibrium) \\\\\n\\midrule\n\\cellcolor{white} \u0026 G6P \u0026 + \\\\\n\\cellcolor{white"
      }, {
        "text": "} \\multirow{-2}{*}{F6P (Fructose-6-Phosphate)} \u0026 F6P \u0026 $-$"
      }, {
        "text": " (self-limiting) \\\\\n\\midrule\n\\cellcolor{white} \u0026 F6P \u0026 + \\\\\n\\"
      }, {
        "text": "cellcolor{white} \\multirow{-2}{*}{F16BP (Fructose-1,6-Bisphosphate)}"
      }, {
        "text": " \u0026 F16BP \u0026 $-$ (self-limiting) \\\\\n\\midrule\n\\cellcolor{white} \u0026 F"
      }, {
